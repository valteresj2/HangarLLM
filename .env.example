# HangarLLM settings
# Every LITELLM_* setting also accepts a HANGARLLM_* spelling. An explicit LITELLM_* value wins.
# Master key, salt key, UI password and database URL are Docker secrets, not .env values.
# Create them with: python scripts/hangar_init_secrets.py
STORE_MODEL_IN_DB = "True"
